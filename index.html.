<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Agent</title>

<style>
:root {
  --bg: #0a0c0f;
  --panel: #101318;
  --panel-2: #0d1014;
  --border: #20252d;
  --border-soft: #181c22;

  --text: #e8ebef;
  --text-2: #a0a7b2;
  --text-3: #68717e;

  --accent: #7c8cff;
  --accent-soft: rgba(124,140,255,.12);

  --user: #171b21;
  --assistant: #0f1216;

  --danger: #d86d76;

  --radius: 12px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  overflow: hidden;
}

button,
textarea,
input {
  font: inherit;
}

button {
  color: inherit;
}

.app {
  display: grid;
  grid-template-columns: 238px minmax(0, 1fr) 292px;
  width: 100%;
  height: 100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: #0c0f13;
  border-right: 1px solid var(--border);
}

.brand {
  height: 68px;
  display: flex;
  align-items: center;
  padding: 0 20px;
  border-bottom: 1px solid var(--border-soft);
}

.brand-mark {
  width: 30px;
  height: 30px;
  border: 1px solid #303641;
  border-radius: 9px;
  display: grid;
  place-items: center;
  margin-right: 10px;
  background: #12161b;
}

.brand-mark svg {
  width: 17px;
  height: 17px;
  stroke: #d9dde4;
}

.brand-name {
  font-size: 14px;
  font-weight: 650;
  letter-spacing: -.01em;
}

.sidebar-content {
  padding: 14px 10px;
  overflow: auto;
}

.new-chat {
  width: 100%;
  height: 40px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border: 1px solid #292f38;
  border-radius: 9px;
  background: #14181e;
  cursor: pointer;
  transition: .15s ease;
  margin-bottom: 16px;
}

.new-chat:hover {
  background: #191e25;
  border-color: #353c47;
}

.new-chat svg {
  width: 16px;
  height: 16px;
  stroke: #c9ced6;
}

.nav-label {
  padding: 0 10px;
  margin: 15px 0 7px;
  color: var(--text-3);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
}

.nav-item {
  height: 38px;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
  text-align: left;
  transition: .15s ease;
}

.nav-item:hover {
  color: var(--text);
  background: #14181e;
}

.nav-item.active {
  color: var(--text);
  background: #171b21;
}

.nav-item svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  flex: 0 0 auto;
}

.recent {
  margin-top: 5px;
}

.recent-item {
  width: 100%;
  display: block;
  padding: 9px 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #8e96a2;
  font-size: 12px;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
}

.recent-item:hover {
  background: #13171c;
  color: #cbd0d8;
}

.sidebar-bottom {
  margin-top: auto;
  padding: 12px;
  border-top: 1px solid var(--border-soft);
}

.connection {
  height: 38px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 10px;
  color: var(--text-3);
  font-size: 11px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #6dbb86;
}

/* =========================
   MAIN
========================= */

.main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.topbar {
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  border-bottom: 1px solid var(--border);
}

.chat-title {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
}

.chat-title span {
  font-size: 14px;
  font-weight: 600;
}

.icon-button {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: var(--text-3);
  cursor: pointer;
}

.icon-button:hover {
  background: #14181d;
  border-color: var(--border);
  color: var(--text);
}

.icon-button svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}

.chat-area {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.chat-inner {
  width: min(850px, calc(100% - 40px));
  margin: 0 auto;
  padding: 52px 0 28px;
}

.empty-state {
  min-height: calc(100vh - 230px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.agent-symbol {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border: 1px solid #303640;
  border-radius: 17px;
  background: #11151a;
  margin-bottom: 20px;
}

.agent-symbol svg {
  width: 29px;
  height: 29px;
  stroke: #cbd1da;
}

.empty-state h1 {
  margin: 0 0 9px;
  font-size: 27px;
  line-height: 1.2;
  font-weight: 650;
  letter-spacing: -.035em;
}

.empty-state p {
  max-width: 480px;
  margin: 0;
  color: var(--text-3);
  font-size: 13px;
  line-height: 1.65;
}

.message {
  display: flex;
  gap: 13px;
  margin-bottom: 25px;
}

.message-avatar {
  width: 31px;
  height: 31px;
  flex: 0 0 31px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #11151a;
  color: #bfc6d0;
  font-size: 11px;
  font-weight: 700;
}

.message.user .message-avatar {
  background: #171b21;
}

.message-avatar svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}

.message-body {
  min-width: 0;
  flex: 1;
}

.message-role {
  margin: 2px 0 7px;
  font-size: 11px;
  font-weight: 650;
  color: #9ca4af;
}

.message-content {
  color: #d8dce2;
  font-size: 14px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message.user .message-content {
  color: #e3e6eb;
}

.typing {
  display: flex;
  align-items: center;
  gap: 5px;
  height: 20px;
}

.typing span {
  width: 4px;
  height: 4px;
  background: #737c89;
  border-radius: 50%;
  animation: typing 1.2s infinite;
}

.typing span:nth-child(2) {
  animation-delay: .15s;
}

.typing span:nth-child(3) {
  animation-delay: .3s;
}

@keyframes typing {
  0%, 60%, 100% {
    opacity: .25;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

/* =========================
   COMPOSER
========================= */

.composer-wrap {
  padding: 12px 20px 18px;
}

.composer {
  width: min(850px, 100%);
  margin: 0 auto;
}

.composer-box {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: 58px;
  padding: 9px;
  border: 1px solid #292f38;
  border-radius: 13px;
  background: #101419;
  transition: border-color .15s ease;
}

.composer-box:focus-within {
  border-color: #3a414c;
}

#input {
  width: 100%;
  min-height: 38px;
  max-height: 180px;
  resize: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  padding: 9px 48px 8px 10px;
  font-size: 13px;
  line-height: 1.5;
}

#input::placeholder {
  color: #5e6672;
}

.send-button {
  position: absolute;
  right: 9px;
  bottom: 9px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid #333a45;
  border-radius: 9px;
  background: #1a1f26;
  color: #dce1e8;
  cursor: pointer;
  transition: .15s ease;
}

.send-button:hover {
  background: #232932;
}

.send-button:disabled {
  opacity: .35;
  cursor: default;
}

.send-button svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
}

.composer-note {
  margin-top: 8px;
  text-align: center;
  color: #4f5762;
  font-size: 10px;
}

/* =========================
   RIGHT PANEL
========================= */

.right-panel {
  min-width: 0;
  background: #0c0f13;
  border-left: 1px solid var(--border);
  overflow-y: auto;
}

.panel-header {
  height: 68px;
  display: flex;
  align-items: center;
  padding: 0 18px;
  border-bottom: 1px solid var(--border-soft);
}

.panel-header h2 {
  margin: 0;
  font-size: 13px;
  font-weight: 650;
}

.panel-content {
  padding: 18px;
}

.agent-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #101419;
}

.agent-card-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.agent-avatar {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid #303640;
  border-radius: 12px;
  background: #14181d;
}

.agent-avatar svg {
  width: 21px;
  height: 21px;
  stroke: #d3d8df;
}

.agent-name {
  font-size: 13px;
  font-weight: 650;
}

.agent-status {
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #6fba87;
  font-size: 10px;
}

.info-section {
  margin-top: 25px;
}

.section-title {
  margin-bottom: 9px;
  color: var(--text-3);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .09em;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 35px;
  padding: 0 1px;
  color: #a2a9b4;
  font-size: 11px;
  border-bottom: 1px solid #171b20;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-value {
  color: #d0d5dc;
}

.memory-box {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #101419;
  color: #8e97a3;
  font-size: 11px;
  line-height: 1.6;
}

.setting-select {
  width: 100%;
  height: 37px;
  padding: 0 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  outline: 0;
  background: #101419;
  color: #bfc5ce;
  cursor: pointer;
}

.danger-button {
  width: 100%;
  height: 37px;
  border: 1px solid #38272b;
  border-radius: 8px;
  background: #171214;
  color: #c9828a;
  cursor: pointer;
  font-size: 11px;
}

.danger-button:hover {
  background: #1c1517;
}

/* =========================
   MODAL
========================= */

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(5px);
}

.modal-overlay.show {
  display: flex;
}

.modal {
  width: min(390px, calc(100% - 30px));
  padding: 20px;
  border: 1px solid #292f38;
  border-radius: 13px;
  background: #11151a;
  box-shadow: 0 20px 70px rgba(0,0,0,.45);
}

.modal h3 {
  margin: 0 0 16px;
  font-size: 15px;
}

.modal input {
  width: 100%;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #2b313a;
  border-radius: 8px;
  outline: none;
  background: #0c1014;
  color: var(--text);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 15px;
}

.modal-actions button {
  height: 36px;
  padding: 0 13px;
  border-radius: 8px;
  border: 1px solid #2a3039;
  background: #171b20;
  cursor: pointer;
  font-size: 11px;
}

.modal-actions .primary {
  background: #e2e5e9;
  color: #101216;
  border-color: #e2e5e9;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 1050px) {
  .app {
    grid-template-columns: 210px minmax(0, 1fr);
  }

  .right-panel {
    display: none;
  }
}

@media (max-width: 700px) {
  body {
    overflow: hidden;
  }

  .app {
    display: block;
  }

  .sidebar {
    display: none;
  }

  .main {
    width: 100%;
    height: 100vh;
  }

  .topbar {
    height: 58px;
    padding: 0 14px;
  }

  .chat-inner {
    width: calc(100% - 24px);
    padding-top: 30px;
  }

  .empty-state {
    min-height: calc(100vh - 205px);
  }

  .empty-state h1 {
    font-size: 23px;
  }

  .composer-wrap {
    padding: 8px 12px 13px;
  }

  .message {
    gap: 9px;
    margin-bottom: 20px;
  }

  .message-avatar {
    width: 28px;
    height: 28px;
    flex-basis: 28px;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M7 8.5C7 6.01 9.01 4 11.5 4h1C14.99 4 17 6.01 17 8.5v7c0 2.49-2.01 4.5-4.5 4.5h-1C9.01 20 7 17.99 7 15.5v-7Z"/>
          <path d="M4 10v4M20 10v4"/>
          <path d="M10 9.5h.01M14 9.5h.01M10 14.5c1.2.8 2.8.8 4 0"/>
        </svg>
      </div>

      <div class="brand-name">AI Agent</div>
    </div>

    <div class="sidebar-content">

      <button class="new-chat" id="newChat">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        <span>Новый чат</span>
      </button>

      <div class="nav-label">Рабочая область</div>

      <button class="nav-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M5 5h14v11H8l-3 3V5Z"/>
        </svg>
        <span>Чат</span>
      </button>

      <button class="nav-item" id="memoryButton">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M6 5h12v14H6z"/>
          <path d="M9 8h6M9 12h6M9 16h4"/>
        </svg>
        <span>Память</span>
      </button>

      <button class="nav-item" id="settingsButton">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/>
          <path d="M19 13.5v-3l-2-.7a7 7 0 0 0-.8-1.8l.8-1.9-2.1-2.1-1.9.8a7 7 0 0 0-1.9-.8L10.5 2h-3l-.7 2a7 7 0 0 0-1.8.8l-1.9-.8L1 6.1 1.8 8a7 7 0 0 0-.8 1.9L-1 10.5v3l2 .7a7 7 0 0 0 .8 1.8L1 17.9 3.1 20l1.9-.8a7 7 0 0 0 1.8.8l.7 2h3l.7-2a7 7 0 0 0 1.9-.8l1.9.8 2.1-2.1-.8-1.9a7 7 0 0 0 .8-1.8l2-.7Z"/>
        </svg>
        <span>Настройки</span>
      </button>

      <div class="nav-label">Последние чаты</div>

      <div class="recent" id="recentChats"></div>

    </div>

    <div class="sidebar-bottom">
      <div class="connection">
        <span class="status-dot"></span>
        <span>Подключение активно</span>
      </div>
    </div>

  </aside>


  <!-- MAIN -->
  <main class="main">

    <header class="topbar">

      <div class="chat-title">
        <span id="chatTitle">Новый чат</span>

        <button class="icon-button" id="renameChat" title="Переименовать">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
            <path d="M4 20h4L18.5 9.5a2.12 2.12 0 0 0-3-3L5 18v2Z"/>
            <path d="m14 7 3 3"/>
          </svg>
        </button>
      </div>

      <button class="icon-button" id="clearTop" title="Очистить чат">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7">
          <path d="M4 7h16"/>
          <path d="M9 7V4h6v3M7 7l1 13h8l1-13"/>
          <path d="M10 11v5M14 11v5"/>
        </svg>
      </button>

    </header>


    <section class="chat-area" id="chatArea">

      <div class="chat-inner" id="chat">

        <div class="empty-state" id="emptyState">

          <div class="agent-symbol">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5">
              <rect x="5" y="6" width="14" height="13" rx="4"/>
              <path d="M9 10h.01M15 10h.01"/>
              <path d="M9 14c1.5 1 4.5 1 6 0"/>
              <path d="M12 6V3"/>
              <circle cx="12" cy="2.5" r=".7" fill="currentColor" stroke="none"/>
            </svg>
          </div>

          <h1>Чем займёмся?</h1>

          <p>
            AI Agent готов работать с текстом, идеями,
            кодом и обычными вопросами.
          </p>

        </div>

      </div>

    </section>


    <div class="composer-wrap">

      <div class="composer">

        <div class="composer-box">

          <textarea
            id="input"
            rows="1"
            placeholder="Напишите сообщение..."
            autocomplete="off"
          ></textarea>

          <button
            class="send-button"
            id="send"
            title="Отправить"
            aria-label="Отправить сообщение"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8">
              <path d="M21 3 10 14"/>
              <path d="m21 3-7 18-4-7-7-4 18-7Z"/>
            </svg>
          </button>

        </div>

        <div class="composer-note">
          AI Agent · ответы могут содержать ошибки
        </div>

      </div>

    </div>

  </main>


  <!-- RIGHT PANEL -->
  <aside class="right-panel">

    <div class="panel-header">
      <h2>Агент</h2>
    </div>

    <div class="panel-content">

      <div class="agent-card">

        <div class="agent-card-top">

          <div class="agent-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5">
              <rect x="5" y="6" width="14" height="13" rx="4"/>
              <path d="M9 10h.01M15 10h.01"/>
              <path d="M9 14c1.5 1 4.5 1 6 0"/>
              <path d="M12 6V3"/>
            </svg>
          </div>

          <div>
            <div class="agent-name">AI Agent</div>

            <div class="agent-status">
              <span class="status-dot"></span>
              Онлайн
            </div>
          </div>

        </div>

      </div>


      <div class="info-section">

        <div class="section-title">Модель</div>

        <div class="info-row">
          <span>Provider</span>
          <span class="info-value">Groq</span>
        </div>

        <div class="info-row">
          <span>Model</span>
          <span class="info-value">GPT-OSS 20B</span>
        </div>

      </div>


      <div class="info-section">

        <div class="section-title">Возможности</div>

        <div class="info-row">
          <span>Диалог</span>
          <span class="info-value">Активен</span>
        </div>

        <div class="info-row">
          <span>История</span>
          <span class="info-value">Локально</span>
        </div>

        <div class="info-row">
          <span>Память</span>
          <span class="info-value">Доступна</span>
        </div>

      </div>


      <div class="info-section">

        <div class="section-title">Память</div>

        <div class="memory-box" id="memoryInfo">
          История текущего диалога сохраняется
          в локальном хранилище браузера.
        </div>

      </div>


      <div class="info-section">

        <div class="section-title">Интерфейс</div>

        <select class="setting-select" id="themeSelect">
          <option value="dark">Тёмная тема</option>
          <option value="light">Светлая тема</option>
        </select>

      </div>


      <div class="info-section">

        <button class="danger-button" id="clearMemory">
          Очистить локальную память
        </button>

      </div>

    </div>

  </aside>

</div>


<!-- RENAME MODAL -->

<div class="modal-overlay" id="renameModal">

  <div class="modal">

    <h3>Название чата</h3>

    <input
      id="renameInput"
      type="text"
      maxlength="50"
      placeholder="Введите название"
    >

    <div class="modal-actions">

      <button id="renameCancel">
        Отмена
      </button>

      <button class="primary" id="renameSave">
        Сохранить
      </button>

    </div>

  </div>

</div>


<script>
/* =========================================================
   CONFIG
========================================================= */

const WORKER_URL =
  "https://aiagentproga.comedyfox6.workers.dev/";


/* =========================================================
   STORAGE
========================================================= */

const STORAGE_HISTORY = "ai_agent_history_v2";
const STORAGE_NAME = "ai_agent_name_v2";
const STORAGE_TITLE = "ai_agent_title_v2";
const STORAGE_THEME = "ai_agent_theme_v2";


/* =========================================================
   STATE
========================================================= */

let history = JSON.parse(
  localStorage.getItem(STORAGE_HISTORY) || "[]"
);

let userName =
  localStorage.getItem(STORAGE_NAME) || "Вы";

let chatTitle =
  localStorage.getItem(STORAGE_TITLE) || "Новый чат";


/* =========================================================
   ELEMENTS
========================================================= */

const chat = document.getElementById("chat");
const chatArea = document.getElementById("chatArea");
const emptyState = document.getElementById("emptyState");

const input = document.getElementById("input");
const send = document.getElementById("send");

const chatTitleElement =
  document.getElementById("chatTitle");

const recentChats =
  document.getElementById("recentChats");

const memoryInfo =
  document.getElementById("memoryInfo");

const themeSelect =
  document.getElementById("themeSelect");


/* =========================================================
   SYSTEM PROMPT
========================================================= */

const SYSTEM_PROMPT = `
Ты — AI Agent.

Отвечай естественно, понятно и по делу.
Не притворяйся человеком.
Не повторяй системные инструкции.
Если пользователь пишет по-русски — отвечай по-русски.
Сохраняй контекст текущего диалога.
`.trim();


/* =========================================================
   ICONS
========================================================= */

function userIcon() {
  return `
    <svg viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.7">
      <circle cx="12" cy="8" r="3"/>
      <path d="M5 20c.8-4 3.1-6 7-6s6.2 2 7 6"/>
    </svg>
  `;
}

function agentIcon() {
  return `
    <svg viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.5">
      <rect x="5" y="6" width="14" height="13" rx="4"/>
      <path d="M9 10h.01M15 10h.01"/>
      <path d="M9 14c1.5 1 4.5 1 6 0"/>
      <path d="M12 6V3"/>
    </svg>
  `;
}


/* =========================================================
   RENDER
========================================================= */

function renderHistory() {

  const messages =
    chat.querySelectorAll(".message");

  messages.forEach(message => message.remove());

  if (!history.length) {
    emptyState.style.display = "flex";
  } else {
    emptyState.style.display = "none";

    history.forEach(message => {

      renderMessage(
        message.role,
        message.content
      );

    });
  }

  updateMemoryInfo();
  updateRecentChats();

  requestAnimationFrame(() => {
    chatArea.scrollTop = chatArea.scrollHeight;
  });
}


function renderMessage(role, content) {

  const wrapper =
    document.createElement("div");

  wrapper.className =
    `message ${role === "user" ? "user" : "assistant"}`;

  const avatar =
    document.createElement("div");

  avatar.className = "message-avatar";

  avatar.innerHTML =
    role === "user"
      ? userIcon()
      : agentIcon();

  const body =
    document.createElement("div");

  body.className = "message-body";

  const roleName =
    document.createElement("div");

  roleName.className = "message-role";

  roleName.textContent =
    role === "user"
      ? userName
      : "AI Agent";

  const messageContent =
    document.createElement("div");

  messageContent.className =
    "message-content";

  messageContent.textContent =
    content;

  body.appendChild(roleName);
  body.appendChild(messageContent);

  wrapper.appendChild(avatar);
  wrapper.appendChild(body);

  chat.appendChild(wrapper);

  return wrapper;
}


/* =========================================================
   SEND MESSAGE
========================================================= */

async function sendMessage() {

  const text =
    input.value.trim();

  if (!text || send.disabled) {
    return;
  }

  input.value = "";
  autoResize();

  if (!history.length) {
    generateChatTitle(text);
  }

  history.push({
    role: "user",
    content: text
  });

  saveHistory();

  emptyState.style.display = "none";

  renderMessage("user", text);

  send.disabled = true;

  const typing =
    document.createElement("div");

  typing.className =
    "message assistant";

  typing.innerHTML = `
    <div class="message-avatar">
      ${agentIcon()}
    </div>

    <div class="message-body">
      <div class="message-role">AI Agent</div>

      <div class="typing">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  `;

  chat.appendChild(typing);

  chatArea.scrollTop =
    chatArea.scrollHeight;


  try {

    const messages = [
      {
        role: "system",
        content: SYSTEM_PROMPT
      },
      ...history
    ];

    const response =
      await fetch(WORKER_URL, {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          messages
        })
      });


    const data =
      await response.json();


    if (!response.ok) {
      throw new Error(
        data?.error ||
        "Ошибка сервера"
      );
    }


    const reply =
      data?.reply ||
      data?.message?.content ||
      "";


    if (!reply) {
      throw new Error(
        "Модель не вернула ответ"
      );
    }


    typing.remove();


    history.push({
      role: "assistant",
      content: reply
    });

    saveHistory();

    renderMessage(
      "assistant",
      reply
    );

  } catch (error) {

    typing.remove();

    renderMessage(
      "assistant",
      "Не удалось получить ответ.\n\n" +
      error.message
    );

  } finally {

    send.disabled = false;

    input.focus();

    updateMemoryInfo();

    chatArea.scrollTop =
      chatArea.scrollHeight;
  }
}


/* =========================================================
   SAVE
========================================================= */

function saveHistory() {

  localStorage.setItem(
    STORAGE_HISTORY,
    JSON.stringify(history)
  );

  updateMemoryInfo();
  updateRecentChats();
}


/* =========================================================
   NEW CHAT
========================================================= */

function newChat() {

  history = [];

  chatTitle = "Новый чат";

  localStorage.setItem(
    STORAGE_HISTORY,
    "[]"
  );

  localStorage.setItem(
    STORAGE_TITLE,
    chatTitle
  );

  chatTitleElement.textContent =
    chatTitle;

  renderHistory();

  input.focus();
}


/* =========================================================
   TITLE
========================================================= */

function generateChatTitle(text) {

  let title =
    text.replace(/\s+/g, " ").trim();

  if (title.length > 34) {
    title =
      title.substring(0, 34).trim() + "…";
  }

  chatTitle = title || "Новый чат";

  localStorage.setItem(
    STORAGE_TITLE,
    chatTitle
  );

  chatTitleElement.textContent =
    chatTitle;
}


/* =========================================================
   RECENT CHATS
========================================================= */

function updateRecentChats() {

  recentChats.innerHTML = "";

  if (!history.length) {
    return;
  }

  const item =
    document.createElement("button");

  item.className = "recent-item";

  item.textContent =
    chatTitle;

  item.title =
    chatTitle;

  item.onclick = () => {
    renderHistory();
  };

  recentChats.appendChild(item);
}


/* =========================================================
   MEMORY INFO
========================================================= */

function updateMemoryInfo() {

  const count =
    history.length;

  if (!count) {

    memoryInfo.textContent =
      "История текущего диалога пока пуста.";

    return;
  }

  const userMessages =
    history.filter(
      message => message.role === "user"
    ).length;

  memoryInfo.textContent =
    `Сохранено сообщений: ${count}. ` +
    `Ваших сообщений: ${userMessages}.`;
}


/* =========================================================
   CLEAR
========================================================= */

function clearMemory() {

  const confirmed =
    confirm(
      "Очистить историю текущего диалога?"
    );

  if (!confirmed) {
    return;
  }

  newChat();
}


/* =========================================================
   RENAME
========================================================= */

const renameModal =
  document.getElementById("renameModal");

const renameInput =
  document.getElementById("renameInput");

function openRename() {

  renameInput.value =
    chatTitle;

  renameModal.classList.add("show");

  setTimeout(() => {
    renameInput.focus();
    renameInput.select();
  }, 20);
}


function closeRename() {

  renameModal.classList.remove("show");
}


function saveRename() {

  const value =
    renameInput.value.trim();

  if (!value) {
    return;
  }

  chatTitle =
    value.substring(0, 50);

  localStorage.setItem(
    STORAGE_TITLE,
    chatTitle
  );

  chatTitleElement.textContent =
    chatTitle;

  updateRecentChats();

  closeRename();
}


/* =========================================================
   TEXTAREA
========================================================= */

function autoResize() {

  input.style.height = "auto";

  input.style.height =
    Math.min(input.scrollHeight, 180) + "px";
}

input.addEventListener(
  "input",
  autoResize
);

input.addEventListener(
  "keydown",
  event => {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      sendMessage();
    }
  }
);


/* =========================================================
   THEME
========================================================= */

function applyTheme(theme) {

  if (theme === "light") {

    document.documentElement.style.setProperty(
      "--bg",
      "#f5f6f8"
    );

    document.documentElement.style.setProperty(
      "--panel",
      "#ffffff"
    );

    document.documentElement.style.setProperty(
      "--panel-2",
      "#f7f8fa"
    );

    document.documentElement.style.setProperty(
      "--border",
      "#dfe3e8"
    );

    document.documentElement.style.setProperty(
      "--border-soft",
      "#e8ebef"
    );

    document.documentElement.style.setProperty(
      "--text",
      "#171a1f"
    );

    document.documentElement.style.setProperty(
      "--text-2",
      "#59616d"
    );

    document.documentElement.style.setProperty(
      "--text-3",
      "#8a929d"
    );

    document.documentElement.style.setProperty(
      "--user",
      "#eceef1"
    );

    document.body.style.background =
      "#f5f6f8";

  } else {

    location.reload();

  }

  localStorage.setItem(
    STORAGE_THEME,
    theme
  );
}


/* =========================================================
   EVENTS
========================================================= */

send.addEventListener(
  "click",
  sendMessage
);

document
  .getElementById("newChat")
  .addEventListener(
    "click",
    newChat
  );

document
  .getElementById("clearTop")
  .addEventListener(
    "click",
    newChat
  );

document
  .getElementById("clearMemory")
  .addEventListener(
    "click",
    clearMemory
  );

document
  .getElementById("renameChat")
  .addEventListener(
    "click",
    openRename
  );

document
  .getElementById("renameCancel")
  .addEventListener(
    "click",
    closeRename
  );

document
  .getElementById("renameSave")
  .addEventListener(
    "click",
    saveRename
  );

renameModal.addEventListener(
  "click",
  event => {

    if (
      event.target === renameModal
    ) {
      closeRename();
    }
  }
);

themeSelect.addEventListener(
  "change",
  () => {

    const value =
      themeSelect.value;

    if (value === "light") {
      applyLightTheme();
    } else {
      location.reload();
    }
  }
);


/* =========================================================
   LIGHT THEME
========================================================= */

function applyLightTheme() {

  const root =
    document.documentElement;

  root.style.setProperty(
    "--bg",
    "#f5f6f8"
  );

  root.style.setProperty(
    "--panel",
    "#ffffff"
  );

  root.style.setProperty(
    "--panel-2",
    "#f7f8fa"
  );

  root.style.setProperty(
    "--border",
    "#dfe3e8"
  );

  root.style.setProperty(
    "--border-soft",
    "#e8ebef"
  );

  root.style.setProperty(
    "--text",
    "#171a1f"
  );

  root.style.setProperty(
    "--text-2",
    "#59616d"
  );

  root.style.setProperty(
    "--text-3",
    "#8a929d"
  );

  root.style.setProperty(
    "--user",
    "#eceef1"
  );

  document.querySelector(".sidebar").style.background =
    "#ffffff";

  document.querySelector(".right-panel").style.background =
    "#ffffff";

  document.querySelector(".main").style.background =
    "#f5f6f8";

  document.querySelector(".composer-box").style.background =
    "#ffffff";

  document.querySelector(".agent-card").style.background =
    "#ffffff";

  document.querySelector(".memory-box").style.background =
    "#ffffff";

  localStorage.setItem(
    STORAGE_THEME,
    "light"
  );
}


/* =========================================================
   INITIALIZATION
========================================================= */

function init() {

  chatTitleElement.textContent =
    chatTitle;

  renderHistory();

  const savedTheme =
    localStorage.getItem(
      STORAGE_THEME
    );

  if (savedTheme === "light") {

    themeSelect.value = "light";

    applyLightTheme();

  } else {

    themeSelect.value = "dark";
  }

  input.focus();
}

init();

</script>

</body>
</html>
