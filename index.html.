
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>AI Agent</title>
<style>
:root {
  --bg: #0a0c0f;
  --bubble-them: #171b21;
  --bubble-me: #1f2530;
  --text: #e8ebef;
  --text-dim: #7d8592;
  --accent: #7c8cff;
  --border: #20252d;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overscroll-behavior: none;
}
body {
  display: flex;
  flex-direction: column;
  height: 100dvh;
}
.topbar {
  flex-shrink: 0;
  height: 56px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  border-bottom: 1px solid var(--border);
}
.topbar-name {
  font-size: 16px;
  font-weight: 600;
}
.topbar-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #6dbb86;
  margin-right: 8px;
  display: inline-block;
}
.chat {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.empty {
  margin: auto;
  text-align: center;
  color: var(--text-dim);
  font-size: 14px;
  padding: 0 30px;
}
.row {
  display: flex;
}
.row.user { justify-content: flex-end; }
.row.assistant { justify-content: flex-start; }
.bubble {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 15px;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-word;
}
.row.user .bubble {
  background: var(--bubble-me);
  border-bottom-right-radius: 4px;
}
.row.assistant .bubble {
  background: var(--bubble-them);
  border-bottom-left-radius: 4px;
}
.typing .bubble {
  display: flex;
  gap: 4px;
  align-items: center;
  padding: 13px 16px;
}
.typing span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--text-dim);
  animation: blink 1.2s infinite;
}
.typing span:nth-child(2) { animation-delay: .15s; }
.typing span:nth-child(3) { animation-delay: .3s; }
@keyframes blink {
  0%, 60%, 100% { opacity: .25; }
  30% { opacity: 1; }
}
.composer-wrap {
  flex-shrink: 0;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--border);
}
.composer {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}
#input {
  flex: 1;
  background: #12161b;
  border: 1px solid var(--border);
  border-radius: 20px;
  color: var(--text);
  font-size: 15px;
  font-family: inherit;
  padding: 10px 16px;
  resize: none;
  max-height: 120px;
  outline: none;
}
#input:focus { border-color: #353c47; }
#send {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--accent);
  border: none;
  color: #0a0c0f;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  flex-shrink: 0;
}
#send:disabled { opacity: .4; }
</style>
</head>
<body>

<div class="topbar">
  <span class="topbar-dot"></span>
  <span class="topbar-name">AI Agent</span>
</div>

<div class="chat" id="chat">
  <div class="empty" id="empty">Напиши что-нибудь, чтобы начать разговор</div>
</div>

<div class="composer-wrap">
  <div class="composer">
    <textarea id="input" rows="1" placeholder="Сообщение…"></textarea>
    <button id="send">↑</button>
  </div>
</div>

<script>
const WORKER_URL = "https://aiagentproga.comedyfox6.workers.dev/";
const STORAGE_KEY = "ai_agent_history_v3";

let history = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");

const chat = document.getElementById("chat");
const empty = document.getElementById("empty");
const input = document.getElementById("input");
const send = document.getElementById("send");

const SYSTEM_PROMPT = `Ты — AI Agent. Отвечай естественно, понятно и по делу. Если пользователь пишет по-русски — отвечай по-русски.`;

function renderAll() {
  chat.querySelectorAll(".row").forEach(r => r.remove());
  if (history.length === 0) {
    empty.style.display = "block";
  } else {
    empty.style.display = "none";
    history.forEach(m => addBubble(m.role, m.content, false));
  }
  scrollDown();
}

function addBubble(role, text, animate = true) {
  empty.style.display = "none";
  const row = document.createElement("div");
  row.className = `row ${role}`;
  const bubble = document.createElement("div");
  bubble.className = "bubble";
  bubble.textContent = text;
  row.appendChild(bubble);
  chat.appendChild(row);
  scrollDown();
  return row;
}

function scrollDown() {
  chat.scrollTop = chat.scrollHeight;
}

function autoResize() {
  input.style.height = "auto";
  input.style.height = Math.min(input.scrollHeight, 120) + "px";
}

input.addEventListener("input", autoResize);
input.addEventListener("keydown", e => {
  if (e.key === "Enter" && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});
send.addEventListener("click", sendMessage);

async function sendMessage() {
  const text = input.value.trim();
  if (!text || send.disabled) return;

  input.value = "";
  autoResize();

  history.push({ role: "user", content: text });
  localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
  addBubble("user", text);

  send.disabled = true;

  const typingRow = document.createElement("div");
  typingRow.className = "row assistant typing";
  typingRow.innerHTML = `<div class="bubble"><span></span><span></span><span></span></div>`;
  chat.appendChild(typingRow);
  scrollDown();

  try {
    const messages = [{ role: "system", content: SYSTEM_PROMPT }, ...history];

    const res = await fetch(WORKER_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages })
    });

    const data = await res.json();
    typingRow.remove();

    if (!res.ok) {
      throw new Error(data?.error || "Ошибка сервера");
    }

    const reply = data?.reply || data?.message?.content || (Array.isArray(data?.messages) ? data.messages.join(" ") : "");

    if (!reply) throw new Error("Модель не вернула ответ");

    history.push({ role: "assistant", content: reply });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
    addBubble("assistant", reply);

  } catch (err) {
    typingRow.remove();
    addBubble("assistant", "Не удалось получить ответ.\n" + err.message);
  } finally {
    send.disabled = false;
    input.focus();
  }
}

renderAll();
</script>

</body>
</html>
